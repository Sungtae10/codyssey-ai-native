{
  "db_path": "data/news.db",
  "output_dir": "output",
  "log_level": "INFO",
  "duplicate_policy": "skip",
  "request_timeout_sec": 10,
  "request_delay_sec": 1.0,
  "user_agent": "CodysseyNewsBot/1.0 (student project)",
  "fetch_full_body": true,
  "sources": {
    "rss": [
      {"name": "google_it", "category": "IT", "url": "https://news.google.com/rss/search?q=IT+%EA%B8%B0%EC%88%A0&hl=ko&gl=KR&ceid=KR:ko"},
      {"name": "google_econ", "category": "경제", "url": "https://news.google.com/rss/search?q=%EA%B2%BD%EC%A0%9C&hl=ko&gl=KR&ceid=KR:ko"},
      {"name": "google_society", "category": "사회", "url": "https://news.google.com/rss/search?q=%EC%82%AC%ED%9A%8C&hl=ko&gl=KR&ceid=KR:ko"}
    ],
    "crawl": [
      {"name": "site_it", "category": "IT", "section_url": "https://<언론사 섹션 URL>",
       "link_selector": "a", "body_selector": "article"}
    ]
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "max_body_chars": 3000,
    "max_articles_for_analysis": 60
  }
}
