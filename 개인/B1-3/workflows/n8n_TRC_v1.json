{
  "name": "TRC-v1 · 기술경영 리서치 큐레이션 (n8n)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 8,
              "minute": 0
            }
