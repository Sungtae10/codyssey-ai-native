# 이 파일을 복사해 .env 를 만들고 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore에 들어 있어 GitHub에 올라가지 않습니다. 키를 코드나 README에 쓰지 마세요.

# ---------- 필수 (최소 세트) ----------
# OpenAI API 키 (platform.openai.com > API keys)
OPENAI_API_KEY=

# Firestore 서비스 계정 키. 둘 중 하나만 쓰면 됩니다.
# (1) 로컬: 키 파일 경로 (backend 폴더 기준 상대 경로 가능)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-key.json
# (2) 배포(Render): 키 파일 내용 전체를 한 줄로. 로컬에서 쓰려면 작은따옴표로 감싸세요.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...", ...}'

# 프론트엔드 주소 (CORS 허용 목록, 쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------- 선택 (비워 두면 아래 기본값) ----------
# 저장소: firestore(기본) | memory(키 없이 화면만 미리 볼 때, 서버를 끄면 사라짐)
# STORAGE_BACKEND=firestore
# OPENAI_MODEL=gpt-6-luna
# OPENAI_FALLBACK_MODEL=gpt-4o-mini
# OPENAI_REASONING_EFFORT=none
# OPENAI_MAX_TOKENS=700
# ENABLE_TOOLS=true
# MAX_TOOL_ROUNDS=3
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_DAILY_LIMIT_PER_IP=100
# CHAT_GLOBAL_RATE_LIMIT_PER_MINUTE=30
# CHAT_DAILY_LIMIT=300
# CHAT_DEADLINE_SECONDS=75
# FIRESTORE_DATABASE_ID=
# 미리보기 주소까지 허용하려면 본인 팀 이름까지 넣은 좁은 정규식으로 (예시)
# ALLOWED_ORIGIN_REGEX=https://usdkrw-ai-assistant-[a-z0-9-]+-내팀이름\.vercel\.app
# TREND_WINDOW=20
# TREND_THRESHOLD_PCT=0.5
