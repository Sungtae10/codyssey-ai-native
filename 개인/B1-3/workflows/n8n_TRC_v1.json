        "feedUrl": "https://rss.etnews.com/Section901.xml",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "RSS Feed Trigger",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "typeVersion": 1,
      "position": [
        -220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ── TRC-v1 계약 (2)(3) 구현 ─────────────────────────────\nconst SIGNAL = {\n  '자본시장': ['투자', '인수', '합병', '지분', '상장'],\n  '기술자산': ['특허', '양산', '출시'],\n  '제도정책': ['규제'],\n  '사업화':   ['계약', '수주', '협력'],\n};\nconst THRESHOLD = 2;   // θ\nconst MAX_ITEMS = 5;   // 계약 (1)\nconst TOOL = 'n8n';\n\nconst stripTags = (s = '') =>\n  String(s).replace(/<[^>]*>/g, ' ').replace(/&[a-zA-Z#0-9]+;/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst jsonSafe = (s = '') =>\n  String(s).replace(/[\"\\\\\\r\\n]/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst kst = (d) => {\n  const dt = d ? new Date(d) : new Date();\n  if (isNaN(dt.getTime())) return '';\n  return new Intl.DateTimeFormat('sv-SE', {\n    timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit',\n    hour: '2-digit', minute: '2-digit', hour12: false,\n  }).format(dt).replace('T', ' ');\n};\n\nconst out = [];\nfor (const item of $input.all().slice(0, MAX_ITEMS)) {\n  const j = item.json;\n  const title = stripTags(j.title);\n  const summary = stripTags(j.contentSnippet || j.content || j.description || '').slice(0, 200);\n  const hay = (title + ' ' + summary).toLowerCase();\n\n  const matched = [];\n  for (const words of Object.values(SIGNAL)) {\n    for (const w of words) {\n      if (hay.includes(w.toLowerCase()) && !matched.includes(w)) matched.push(w);\n    }\n  }\n  const score = matched.length;\n\n  out.push({ json: {\n    collected_at: kst(),\n    tool: TOOL,\n    tier: score >= THRESHOLD ? 'CORE' : 'REF',\n    score,\n    matched_keywords: matched.join(',') || '-',\n    title,\n    title_safe: jsonSafe(title),\n    summary,\n    published_at: kst(j.isoDate || j.pubDate),\n    link: j.link || '',\n  }});\n}\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "정규화+스코어링",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-core",
                    "leftValue": "={{ $json.score }}",
                    "rightValue": 2,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CORE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "cond-ref",
                    "leftValue": "={{ $json.score }}",
                    "rightValue": 2,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "REF"
            }
          ]
        },
        "options": {
          "fallbackOutput": 1
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
