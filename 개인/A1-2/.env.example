# 이 파일을 복사해 .env로 저장한 뒤, '=' 뒤에 값만 채우세요. (따옴표, 공백 없이)
#   Windows PowerShell : Copy-Item .env.example .env
#   macOS / Linux      : cp .env.example .env
# .env는 .gitignore에 들어 있어 Git에 올라가지 않습니다. 이 예시 파일에는 실제 키를 적지 마세요.

# ---- 1) LLM API: openai 또는 gemini ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Gemini를 쓸 때만: 위 LLM_PROVIDER를 gemini로 바꾸고 아래 키를 채우세요.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- 2) 지도/장소 검색 API: kakao 또는 naver ----
PLACE_PROVIDER=kakao
KAKAO_REST_API_KEY=

# Naver를 쓸 때만: 위 PLACE_PROVIDER를 naver로 바꾸고 아래 두 값을 채우세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
