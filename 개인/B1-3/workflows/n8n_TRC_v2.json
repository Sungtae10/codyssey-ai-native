            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-photo",
              "leftValue": "={{ $json.title }}",
              "rightValue": "[포토]",
              "operator": {
                "type": "string",
